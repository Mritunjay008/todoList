# ==========================================
# Root .gitignore for Full-Stack TaskFlow
# (.NET 8 Web API + React 19 Frontend)
# ==========================================

# ------------------------------------------
# .NET / C# Build Artifacts
# ------------------------------------------
**/bin/
**/obj/
**/Debug/
**/Release/
**/x64/
**/x86/
**/[Bb]uild/
**/[Bb]in/
**/[Oo]bj/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.dll
*.exe
*.pdb

# ------------------------------------------
# SQLite & Local Databases
# ------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/todos.db*

# ------------------------------------------
# Node.js & React Frontend
# ------------------------------------------
**/node_modules/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ------------------------------------------
# IDEs & Editor Files
# ------------------------------------------
.vs/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------
# Azure & Cloud Deployment Artifacts
# ------------------------------------------
.azure/
publish/
**/publish/
azure-pipelines.yml.bak
